# ─────────────────────────────────────────────────────────────────────────────
# ZapFome — Variáveis de Ambiente (copie para .env e preencha)
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB
MONGO_URL="mongodb://db:27017"           # Docker: mongodb://db:27017 | Atlas: mongodb+srv://...
DB_NAME="ifood2"

# Segurança — gere com: python -c "import secrets; print(secrets.token_urlsafe(40))"
OWNER_API_TOKEN="TROQUE_POR_TOKEN_GERADO_ALEATORIAMENTE"

# OpenAI
OPENAI_API_KEY="sk-COLOQUE_SUA_CHAVE_AQUI"
OPENAI_MODEL="gpt-4o-mini"              # modelos: gpt-4o-mini (barato) | gpt-4o (melhor)

# Impressora térmica (somente Windows)
RECEIPT_PRINTER_NAME="Knup KP-IM607"
PRINT_TIMEOUT_SEC=12
PRINT_MAX_CHARS=12000

# CORS — em produção: coloque o domínio real do seu frontend
CORS_ORIGINS="https://seudominio.com,https://www.seudominio.com"

# Taxa de entrega padrão (R$)
TAXA_ENTREGA=5.0

# HMAC opcional — assina requisições de impressão
# API_HMAC_SECRET="gere_valor_aleatorio"
