# ── Environment ──────────────────────────────────────────────────────────────
# "development" enables hot-reload; anything else = production mode
ENV=production

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URL=mongodb://localhost:27017
DB_NAME=ifood2

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── WhatsApp Business API ─────────────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=troque_por_token_secreto
# Deixe em branco para desativar resposta automática ao cliente:
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque_em_producao_por_string_aleatoria_de_64_chars
ADMIN_USER=admin
ADMIN_PASS=troque_por_senha_forte

# ── CORS ─────────────────────────────────────────────────────────────────────
# Produção: use a URL exata do seu frontend, ex: https://meurestaurante.com
# Desenvolvimento: *
CORS_ORIGINS=*

# ── Super Admin / Uploads ─────────────────────────────────────────────────────
SUPER_ADMIN_KEY=change-me-in-production
UPLOAD_DIR=/app/uploads
