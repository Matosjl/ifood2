NODE_ENV=development
PORT=3000

# Redis — usado por BullMQ (filas), Socket.io adapter (WebSocket) e cache
REDIS_URL=redis://localhost:6379

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saas_restaurant
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# JWT — gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque_por_string_aleatoria_de_128_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=outro_secret_diferente_do_access_token
JWT_REFRESH_EXPIRES_IN=7d

# CORS — separe por vírgula em produção
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
