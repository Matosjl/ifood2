# =============================================================
# SANDBOX (caixinha local) — backend
# =============================================================
# Carregado via: npx dotenv -e .env.sandbox -- node src/server.js
# (ou pelo script `npm run dev:sandbox`)
#
# ⚠️ Não use esses valores em produção. Não commite secrets reais aqui.
# =============================================================

NODE_ENV=sandbox
PORT=3010

# ── Postgres sandbox (porta 5433 do docker-compose.sandbox.yml) ──
DB_HOST=localhost
DB_PORT=5433
DB_NAME=zapfome_sandbox
DB_USER=zapfome
DB_PASSWORD=sandbox

# ── Redis sandbox (porta 6380) ───────────────────────────────────
REDIS_URL=redis://localhost:6380

# ── JWT (gere os seus com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))") ──
JWT_SECRET=sandbox_jwt_secret_troque_isto_64_bytes_minimo_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=sandbox_refresh_secret_troque_isto_64_bytes_diferente_bbbbbbbbbbbbbbbbbbbbb
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5174,http://localhost:5173

# ── Super Admin ──────────────────────────────────────────────────
SUPER_ADMIN_KEY=sandbox-super-admin

# ── AI Engine (VPS2) ─────────────────────────────────────────────
# Opção A: apontar pra VPS2 real (testa OCR de verdade, mas usa GPU/RAM da VPS)
# VPS2_URL=http://69.10.43.169:3001
#
# Opção B: rodar engine local de IA (próximo passo — vamos criar `ai-engine/`)
VPS2_URL=http://localhost:3001
AI_ENGINE_KEY=sandbox-ai-engine-key
INTERNAL_KEY=sandbox-internal-key

# ── Evolution API ────────────────────────────────────────────────
# Opção A: instância Evolution sandbox local (descomente o serviço no docker-compose.sandbox.yml)
# EVOLUTION_API_URL=http://localhost:8081
# EVOLUTION_API_KEY=sandbox-evolution-key-troque-isto
#
# Opção B: mockar webhook via curl (deixar vazio enquanto desenvolve)
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=sandbox-evolution-key
