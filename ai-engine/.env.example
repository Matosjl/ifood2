# ── AI Engine VPS2 — config ────────────────────────────────────
PORT=3001
LOG_LEVEL=info

# ── Ollama ────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision:11b-q4_K_M
OLLAMA_REQUEST_TIMEOUT=120

# ── Auth (deve bater com AI_ENGINE_KEY do saas-backend) ───────
AI_ENGINE_KEY=sandbox-ai-engine-key

# ── Concorrência (proteção pra VPS de 8GB RAM) ────────────────
MAX_CONCURRENT_VISION=2

# ── Image processing ──────────────────────────────────────────
IMAGE_MAX_SIDE_PX=1024
IMAGE_JPEG_QUALITY=85
