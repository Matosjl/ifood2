# =============================================================
# SaaS Restaurant — Environment Variables
# =============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in every value
# 3. NEVER commit .env to git
#
# Generate secrets:  ./scripts/generate-secrets.sh
# =============================================================

# ── App ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Domain (used by Nginx SSL and CORS) ──────────────────────
DOMAIN=app.seusite.com
# VITE_API_URL must match the public URL of the site
VITE_API_URL=https://app.seusite.com

# ── Database (PostgreSQL) ─────────────────────────────────────
# DB_HOST is overridden to "postgres" inside Docker — set localhost for local dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=saas_restaurant
DB_USER=saas_user
# Generate: openssl rand -hex 32
DB_PASSWORD=CHANGE_ME_strong_password_here

# ── Redis ─────────────────────────────────────────────────────
# REDIS_URL is overridden in docker-compose to use the redis service + password
REDIS_URL=redis://localhost:6379
# Generate: openssl rand -hex 24
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# ── JWT ───────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_byte_hex_string_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_different_64_byte_hex_string
JWT_REFRESH_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed origins in production
CORS_ORIGINS=https://app.seusite.com

# ── Email (future — password reset) ──────────────────────────
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.xxx

# ── Payment (future — Stripe / Mercado Pago) ─────────────────
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# MP_ACCESS_TOKEN=APP_USR-xxx
